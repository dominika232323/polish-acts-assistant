# Copy to .env (`make setup` does it) and adjust. Do not commit .env.

# ---------------------------------------------------------------- LLM (Ollama, OpenAI-compatible API)
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
# qwen3.5:4b runs fully on a 6 GB GPU and stays loaded next to the embedding model;
# qwen3.5:9b answers better but is slower (partly on CPU, swaps with the embedding model)
LLM_MODEL=qwen3.5:4b
# "none" disables qwen3.5 thinking mode (answers in a fraction of the time).
# Leave empty if the server does not support the reasoning_effort parameter.
LLM_REASONING_EFFORT=none
LLM_TEMPERATURE=0

# ---------------------------------------------------------------- Embedding
EMBED_MODEL=qwen3-embedding:0.6b
# Instruction prepended to queries (not documents) – qwen3-embedding is trained this way.
EMBED_QUERY_INSTRUCTION=Given a question, retrieve passages from Polish acts that answer it
# After changing EMBED_MODEL, re-index all documents.
